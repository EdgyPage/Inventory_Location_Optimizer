# Copy to `.env` at the repo root and fill in the values. `.env` is gitignored — it is the one
# file that may name your machine.
#
# ── how these values are read ───────────────────────────────────────────────────────────
# NOT python-dotenv. Optimization/config/sim_config.py has a small hand-rolled loader that runs
# at import time, and its limitations are load-bearing:
#
#   * NO EXPANSION. `~`, `%USERPROFILE%` and `$HOME` are NOT expanded — a value of `~/runs`
#     creates a directory literally named `~`. Write a full absolute path.
#   * A variable already set in your shell WINS; .env never overwrites it. That is the
#     supported way to redirect a single run without editing this file.
#   * The line is split on the FIRST `=`, then surrounding quotes are stripped.
#   * A Windows path may be written raw-prefixed — `KEY=r"DRIVE:\dir\sub"` — and the `r"` and
#     the quotes are removed for you. A plain unquoted path works too; backslashes are fine.
#   * No interpolation, no `export`, no multi-line values.
#
# (The examples above are written `DRIVE:\dir\sub` rather than with a real drive letter on
# purpose: context/guards/path_guard.py blocks machine-local paths in tracked files, and a
# literal example would trip it.)

# ── required ────────────────────────────────────────────────────────────────────────────
# Parent directory for the comparison_<timestamp>/ run trees.
#
# ►► PUT THIS ON A LOCAL OR EXTERNAL DRIVE, NEVER IN A SYNCED FOLDER. ◄◄
# A full sweep is hundreds of GB. If OneDrive / Dropbox / Google Drive can see this directory
# it will try to upload all of it — this has already happened once.
#
# Leaving it EMPTY is the dangerous case, not an error: it silently falls back to a path inside
# the source tree, and a run writes its entire output into the repo. See README.md.
COMPARISON_OUTPUT_DIR=

# Root directory holding the inventory+affinity profile pairs the simulator consumes, as
# produced by Warehouse/generation/generate_mixed_profile.py. Hundreds of MB per profile —
# also keep it out of a synced folder. Empty falls back to Warehouse/generated/profiles/
# inside the repo.
PROFILE_INPUT_DIR=

# ── optional ────────────────────────────────────────────────────────────────────────────
# Bulk storage for scripts/archive_cells.py, which moves finished what-if cells off the hot
# drive mid-run and leaves a directory junction behind, so nothing downstream can tell the
# difference. Only needed when the hot drive cannot hold a whole sweep. Unset simply disables
# the archiver.
# COLD_DRIVE=

# Set to 1 to skip the run-tree schema preflight entirely. The preflight sets this itself for
# its own canary subprocesses so they cannot recurse; you rarely want it by hand.
# ILO_SKIP_PREFLIGHT=
